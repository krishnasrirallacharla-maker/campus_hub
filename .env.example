# Application Configuration
PROJECT_NAME="College Management Event System"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-super-secret-key-in-production-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/college_events_db"

# Admin Initial Seed Credentials
FIRST_SUPERUSER_EMAIL="admin@college.edu"
FIRST_SUPERUSER_PASSWORD="AdminPassword123!"
FIRST_SUPERUSER_NAME="System Administrator"

# CORS Configuration (comma-separated origins or ["*"])
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Environment mode: development, staging, production
ENVIRONMENT="development"
DEBUG=True
